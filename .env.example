# Django Settings
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Security - Generate a new key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Debug mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
# Development: localhost,127.0.0.1
# Production: your-domain.com,www.your-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Leave unset to use SQLite (default for local development)
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/anime_news

# Docker PostgreSQL (used by docker-compose):
# DATABASE_URL=postgresql://anime_user:anime_pass@db:5432/anime_news
