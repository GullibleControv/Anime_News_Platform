# =================================================================
# PRODUCTION Environment Variables
# =================================================================
# Copy this to .env on your server and fill in real values
# NEVER commit this file with real values to git!
# =================================================================

# Security - Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Your domain (comma-separated, no spaces)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database credentials
DB_USER=anime_user
DB_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
DB_NAME=anime_news

# Optional: Email settings for password reset
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
